# Copy to .env.local and fill in. Without these the site runs on bundled seed content.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # (or NEXT_PUBLIC_SUPABASE_ANON_KEY on older projects)
# Server only — never expose. Enables contact-form rate limiting.
SUPABASE_SERVICE_ROLE_KEY=        # Secret key (sb_secret_…) — optional

# Your live URL (used for canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: email me when someone uses the contact form (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=sharier48@gmail.com
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>   # after verifying a domain in Resend
